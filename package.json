{
  "name": "react-express-quiz-app",
  "version": "1.0.0",
  "description": "StudyShark and devShark bilingual learning platform with React, Vercel, and Supabase",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vercel dev --listen 3000",
    "build": "cd client && npm run build",
    "typecheck:api": "tsc --noEmit",
    "test:launch": "client/node_modules/.bin/esbuild scripts/test-launch-contracts.ts --bundle --platform=node --format=esm --outfile=/tmp/shark-launch-contracts.mjs && node /tmp/shark-launch-contracts.mjs",
    "preview": "vercel dev --listen 3000",
    "install:all": "npm install && cd client && npm install"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3"
  }
}
