{
  "name": "react-express-quiz-app",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "StudyShark and devShark bilingual learning platform with React, Vercel, and Supabase",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vercel dev --listen 3000",
    "build": "cd client && npm run build",
    "typecheck:api": "tsc --noEmit",
    "test:launch": "esbuild scripts/test-launch-contracts.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/shark/launch-contracts.mjs --log-level=warning && node node_modules/.cache/shark/launch-contracts.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "preview": "vercel dev --listen 3000",
    "install:all": "npm install && cd client && npm install",
    "test:coding": "esbuild scripts/test-coding-content.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/shark/coding-content.mjs --log-level=warning && node node_modules/.cache/shark/coding-content.mjs",
    "build:coding-index": "esbuild scripts/build-coding-index.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/shark/coding-index.mjs --log-level=warning && CODING_INDEX_WRITE=1 node node_modules/.cache/shark/coding-index.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.5",
    "esbuild": "^0.25.12",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@supabase/supabase-js": "^2.110.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "quickjs-emscripten": "^0.32.0"
  }
}
