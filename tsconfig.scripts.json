{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "tests/browser/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["scripts/fixtures", "client/dist", "node_modules"]
}
