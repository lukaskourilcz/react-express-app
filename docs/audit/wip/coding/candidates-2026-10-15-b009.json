{
  "js-easy4-grid-differences": {
    "alternative": "const differences=(a,b)=>a.flatMap((row,r)=>row.flatMap((v,c)=>v!==b[r][c]?[[r,c]]:[]));",
    "wrong-object-is": "const differences=(a,b)=>a.flatMap((row,r)=>row.flatMap((v,c)=>!Object.is(v,b[r][c])?[[r,c]]:[]));",
    "wrong-json-equality": "const differences=(a,b)=>a.flatMap((row,r)=>row.flatMap((v,c)=>JSON.stringify(v)!==JSON.stringify(b[r][c])?[[r,c]]:[]));",
    "wrong-mutates-after": "const differences=(a,b)=>{const out=a.flatMap((row,r)=>row.flatMap((v,c)=>v!==b[r][c]?[[r,c]]:[]));a.reverse();b.reverse();return out;};"
  },
  "js-easy3-pick-list": {
    "alternative": "const pickList=order=>{const out=[];for(const item of order)for(let i=0;i<item.qty;i++)out.push(item.name);return out;};",
    "wrong-filter-empty": "const pickList=order=>order.flatMap(i=>Array(i.qty).fill(i.name)).filter(Boolean);",
    "wrong-deduplicates": "const pickList=order=>[...new Set(order.flatMap(i=>Array(i.qty).fill(i.name)))];",
    "wrong-mutates-zero-qty": "const pickList=order=>{const out=order.flatMap(i=>Array(i.qty).fill(i.name));for(const item of order)if(item.qty===0)item.qty=1;return out;};"
  },
  "js-easy4-letters-in-order": {
    "alternative": "const inOrder=(short,long)=>{let start=0;for(let i=0;i<short.length;i++){const at=long.indexOf(short[i],start);if(at<0)return false;start=at+1;}return true;};",
    "wrong-code-points": "const inOrder=(short,long)=>{const a=[...short];let i=0;for(const c of long)if(c===a[i])i++;return i===a.length;};",
    "wrong-case-folds": "const inOrder=(short,long)=>{short=short.toLowerCase();long=long.toLowerCase();let i=0;for(let j=0;j<long.length;j++)if(short[i]===long[j])i++;return i===short.length;};",
    "wrong-sorts": "const inOrder=(short,long)=>{short=[...short].sort().join(\"\");long=[...long].sort().join(\"\");let i=0;for(let j=0;j<long.length;j++)if(short[i]===long[j])i++;return i===short.length;};"
  },
  "js-easy4-mirror-lists": {
    "alternative": "const isMirror=(a,b)=>a.length===b.length&&[...b].reverse().every((v,i)=>v===a[i]);",
    "wrong-object-is": "const isMirror=(a,b)=>a.length===b.length&&a.every((v,i)=>Object.is(v,b[b.length-1-i]));",
    "wrong-json": "const isMirror=(a,b)=>JSON.stringify(a)===JSON.stringify([...b].reverse());",
    "wrong-mutates-on-success": "const isMirror=(a,b)=>{const ok=a.length===b.length&&a.every((v,i)=>v===b[b.length-1-i]);if(ok&&a.length>2)b.reverse();return ok;};"
  },
  "js-easy3-newest-first": {
    "alternative": "const newestFirst=posts=>posts.map((post,index)=>({post,index})).sort((a,b)=>a.post.date===b.post.date?a.index-b.index:a.post.date>b.post.date?-1:1).map(entry=>entry.post);",
    "wrong-clones": "const newestFirst=posts=>JSON.parse(JSON.stringify(posts)).sort((a,b)=>a.date>b.date?-1:a.date<b.date?1:0);",
    "wrong-reuses-empty": "const newestFirst=posts=>posts.length?[...posts].sort((a,b)=>a.date>b.date?-1:a.date<b.date?1:0):posts;",
    "wrong-deduplicates": "const newestFirst=posts=>[...new Set(posts)].sort((a,b)=>a.date>b.date?-1:a.date<b.date?1:0);"
  }
}
