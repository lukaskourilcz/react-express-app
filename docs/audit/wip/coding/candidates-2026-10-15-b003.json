{
  "js-average": {
    "wrong-nonnumeric-decimals": "const average=ns=>{if(!ns.length)return 0;const result=ns.reduce((sum,n)=>sum+n,0)/ns.length;return ns.some(n=>!Number.isInteger(n))?String(result):result;};",
    "alternative": "const average=ns=>ns.reduce((mean,n,i)=>mean+(n-mean)/(i+1),0);",
    "wrong-rounded": "const average=ns=>ns.length?Math.round(ns.reduce((a,n)=>a+n,0)/ns.length*100)/100:0;",
    "wrong-half": "const average=ns=>ns.length?ns.reduce((a,n)=>a+n,0)/2:0;",
    "wrong-mutating-sort": "const average=ns=>{ns.sort((a,b)=>a-b);return ns.length?ns.reduce((a,n)=>a+n,0)/ns.length:0;};"
  },
  "js-short-words": {
    "alternative": "const shortWords=ws=>ws.reduce((out,w)=>{if(w.length<5)out.push(w);return out;},[]);",
    "wrong-code-points": "const shortWords=ws=>ws.filter(w=>[...w].length<5);",
    "wrong-includes-five": "const shortWords=ws=>ws.filter(w=>w.length<=5);",
    "wrong-deduplicates": "const shortWords=ws=>[...new Set(ws.filter(w=>w.length<5))];"
  },
  "js-object-keys": {
    "alternative": "const keys=o=>Reflect.ownKeys(o).filter(k=>typeof k==='string'&&Object.prototype.propertyIsEnumerable.call(o,k));",
    "wrong-inherited": "const keys=o=>{const out=[];for(const k in o)out.push(k);return out;};",
    "wrong-nonenumerable": "const keys=o=>Object.getOwnPropertyNames(o);",
    "wrong-symbols": "const keys=o=>Reflect.ownKeys(o);"
  },
  "js-object-values": {
    "alternative": "const values=o=>Object.entries(o).map(([,value])=>value);",
    "wrong-inherited": "const values=o=>{const out=[];for(const k in o)out.push(o[k]);return out;};",
    "wrong-clones": "const values=o=>JSON.parse(JSON.stringify(Object.values(o)));",
    "wrong-filters-values": "const values=o=>Object.values(o).filter(Boolean);"
  },
  "js-activate-user": {
    "wrong-mutates-nested": "const activate=o=>{const out={...o,active:true};if(out.payload)out.payload.n++;return out;};",
    "alternative": "const activate=o=>Object.fromEntries([...Reflect.ownKeys(o).filter(k=>Object.prototype.propertyIsEnumerable.call(o,k)).map(k=>[k,o[k]]),['active',true]]);",
    "wrong-mutates": "const activate=o=>Object.assign(o,{active:true});",
    "wrong-clones": "const activate=o=>({...JSON.parse(JSON.stringify(o)),active:true});",
    "wrong-assign-plain-target": "const activate=o=>Object.assign({},o,{active:true});"
  }
}
