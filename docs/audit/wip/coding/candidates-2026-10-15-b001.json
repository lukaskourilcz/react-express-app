{
  "js-positive-numbers": {
    "alternative": "function positives(numbers){return numbers.reduce((out,n)=>{if(n>0)out.push(n);return out;},[]);}",
    "wrong-zero": "const positives=ns=>ns.filter(n=>n>=0);",
    "wrong-reuses-all-positive": "const positives=ns=>ns.every(n=>n>0)?ns:ns.filter(n=>n>0);",
    "wrong-deduplicates": "const positives=ns=>[...new Set(ns.filter(n=>n>0))];"
  },
  "js-square-numbers": {
    "alternative": "function squares(numbers){const result=[];for(let i=0;i<numbers.length;i++)result[i]=numbers[i]*numbers[i];return result;}",
    "wrong-absolute": "const squares=ns=>ns.map(Math.abs);",
    "wrong-reuses-empty": "const squares=ns=>ns.length?ns.map(n=>n*n):ns;",
    "wrong-mutates-positive": "const squares=ns=>{if(ns.some(n=>n<0))return ns.map(n=>n*n);for(let i=0;i<ns.length;i++)ns[i]*=ns[i];return ns.slice();};"
  },
  "js-largest-number": {
    "alternative-sorting-copy": "const largest=ns=>[...ns].sort((a,b)=>b-a)[0];",
    "alternative": "function largest(numbers){let result=-Infinity;for(let i=0;i<numbers.length;i++)if(numbers[i]>result)result=numbers[i];return result;}",
    "wrong-zero-seed": "const largest=ns=>ns.reduce((a,n)=>n>a?n:a,0);",
    "wrong-mutating-sort": "const largest=ns=>ns.sort((a,b)=>b-a)[0];",
    "wrong-rounded": "const largest=ns=>Math.round(Math.max(...ns));"
  },
  "js-countdown": {
    "alternative": "const countDown=n=>Array.from({length:n},(_,i)=>i+1).reverse();",
    "wrong-includes-zero": "const countDown=n=>Array.from({length:n+1},(_,i)=>n-i);",
    "wrong-starts-below": "const countDown=n=>Array.from({length:Math.max(0,n-1)},(_,i)=>n-i-1);",
    "wrong-known-only": "const countDown=n=>({0:[],1:[1],2:[2,1],3:[3,2,1],4:[4,3,2,1],5:[5,4,3,2,1],7:[7,6,5,4,3,2,1]})[n]??[];"
  },
  "js-has-adult": {
    "alternative": "const hasAdult=ages=>ages.reduce((found,age)=>found||age>=18,false);",
    "wrong-strict-threshold": "const hasAdult=ages=>ages.some(age=>age>18);",
    "wrong-mutating-sort": "const hasAdult=ages=>{ages.sort((a,b)=>b-a);return ages.length>0&&ages[0]>=18;};",
    "wrong-every": "const hasAdult=ages=>ages.every(age=>age>=18);"
  }
