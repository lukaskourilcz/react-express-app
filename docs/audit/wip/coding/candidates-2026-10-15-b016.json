{
"js-easy3-count-files":{"alternative":"function countFiles(e){return e.children===undefined?1:e.children.reduce((n,x)=>n+countFiles(x),0);}","wrong-deduplicate":"const countFiles=e=>{const names=new Set();function walk(x){if(x.children)x.children.forEach(walk);else names.add(x.name);}walk(e);return names.size;};","wrong-mutate":"const countFiles=e=>{if(!e.children)return 1;let n=0;while(e.children.length)n+=countFiles(e.children.pop());return n;};"},
"js-easy3-nesting-depth":{"alternative":"function depth(a){return a.reduce((d,x)=>Array.isArray(x)?Math.max(d,1+depth(x)):d,1);}","wrong-objects":"const depth=a=>1+a.reduce((d,x)=>x&&typeof x==='object'?Math.max(d,depth(Array.isArray(x)?x:Object.values(x))):d,0);","wrong-mutate":"const depth=a=>{let d=0;while(a.length){const x=a.pop();if(Array.isArray(x))d=Math.max(d,depth(x));}return d+1;};"},
"js-easy3-changed-since-last":{"alternative":"function makeChangeWatcher(){let first=true,previous;return value=>{const out=first||previous!==value;first=false;previous=value;return out;};}","wrong-object-is":"const makeChangeWatcher=()=>{let first=true,old;return v=>{const changed=first||!Object.is(v,old);first=false;old=v;return changed;};};","wrong-json":"const makeChangeWatcher=()=>{let first=true,old;return v=>{const now=JSON.stringify(v);const out=first||now!==old;first=false;old=now;return out;};};"},
"js-easy2-running-average":{"alternative":"function makeAverager(){let sum=0,n=0;return value=>{sum+=value;n++;return sum/n;};}","wrong-cap":"const makeAverager=()=>{let sum=0,n=0;return v=>{sum+=v;n++;return n>10?0:sum/n;};};","wrong-round":"const makeAverager=()=>{let sum=0,n=0;return v=>Math.round((sum+=v)/++n*10)/10;};"},
"js-call-once":{"alternative":"function once(fn){let done=false,result;return function(...args){if(!done){done=true;result=fn(...args);}return result;};}","wrong-clone":"const once=fn=>{let done=false,result;return(...args)=>{if(!done){done=true;result=fn(...args);}return result&&typeof result==='object'?JSON.parse(JSON.stringify(result)):result;};};","wrong-pairs":"const once=fn=>{let done=false,result;return(a,b)=>{if(!done){done=true;result=fn(a,b);}return result;};}"}
}
