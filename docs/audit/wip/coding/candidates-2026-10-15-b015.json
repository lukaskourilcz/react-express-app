{
  "js-easy2-factorial": {
    "alternative": "function factorial(n){return n<2?1:n*factorial(n-1);}",
    "wrong-capped": "const factorial=n=>n>10?0:n===0?1:n*factorial(n-1);",
    "wrong-off-by-one": "const factorial=n=>n===0?1:(n+1)*factorial(n-1);"
  },
  "js-easy2-power": {
    "alternative": "function power(base,n){return n===0?1:base*power(base,n-1);}",
    "wrong-round-base": "const power=(base,n)=>n===0?1:Math.round(base)*power(base,n-1);",
    "wrong-signed-zero": "const power=(base,n)=>n===0?1:(base*power(base,n-1)||0);"
  },
  "js-easy4-clamp-defaults": {
    "alternative": "function clamp(v,min=0,max=100){return v<min?min:v>max?max:v;}",
    "wrong-round": "const clamp=(v,min=0,max=100)=>v<min?min:v>max?max:Math.round(v);",
    "wrong-signed-zero": "const clamp=(v,min=0,max=100)=>Math.min(Math.max(v,min),max);"
  },
  "js-easy4-to-binary": {
    "alternative": "function toBinary(n){if(n<2)return String(n);return toBinary(Math.floor(n/2))+String(n%2);}",
    "wrong-32-bit": "const toBinary=n=>n<2?String(n):toBinary(n>>1)+(n&1);",
    "wrong-truncate": "const toBinary=n=>{n=n>>>0;return n<2?String(n):toBinary(Math.floor(n/2))+(n%2);};"
  },
  "js-easy2-list-to-array": {
    "alternative": "function toArray(node){const out=[];function walk(n){if(n===null)return;out.push(n.value);walk(n.next);}walk(node);return out;}",
    "wrong-clone": "const toArray=n=>n===null?[]:[JSON.parse(JSON.stringify(n.value)),...toArray(n.next)];",
    "wrong-mutate": "const toArray=n=>{if(n===null)return [];const rest=n.next;n.next=null;return [n.value,...toArray(rest)];};"
  }
}
