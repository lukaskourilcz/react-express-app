{
  "ts-typed-slug": {
    "alternative": "function toSlug(title:string):string{return title.toLowerCase().trim().replace(/\\s+/g,'-');}",
    "wrong-literal-spaces": "const toSlug=(title:string):string=>title.trim().toLowerCase().split(' ').filter(Boolean).join('-');",
    "wrong-url-encoding": "const toSlug=(title:string):string=>encodeURIComponent(title.trim().toLowerCase().replace(/\\s+/g,'-'));",
    "wrong-any-parameter": "const toSlug=(title:any):string=>title.trim().toLowerCase().replace(/\\s+/g,'-');"
  },
  "ts-top-three-scores": {
    "alternative": "function topThree(scores:number[]):number[]{const best:number[]=[];for(const score of scores){let i=0;while(i<best.length&&best[i]>=score)i++;best.splice(i,0,score);if(best.length>3)best.pop();}return best;}",
    "wrong-deduplicates": "const topThree=(scores:number[]):number[]=>[...new Set(scores)].sort((a,b)=>b-a).slice(0,3);",
    "wrong-mutates": "const topThree=(scores:number[]):number[]=>scores.sort((a,b)=>b-a).slice(0,3);",
    "wrong-empty-reuse": "const topThree=(scores:number[]):number[]=>scores.length<2?scores:[...scores].sort((a,b)=>b-a).slice(0,3);"
  },
  "ts-greeting-with-a-default": {
    "alternative": "function greet(name:string,greeting?:string):string{return (greeting===undefined?'Hello':greeting)+', '+name+'!';}",
    "wrong-falsey-default": "const greet=(name:string,greeting?:string):string=>(greeting||'Hello')+', '+name+'!';",
    "wrong-number-name": "const greet=(name:any,greeting?:string):string=>(greeting===undefined?'Hello':greeting)+', '+name+'!';",
    "wrong-any-return": "const greet=(name:string,greeting?:string):any=>(greeting===undefined?'Hello':greeting)+', '+name+'!';"
  },
  "ts-person-interface": {
    "alternative": "type Person={first:string,last:string};function fullName(person:Person):string{const parts=[person.first.trim(),person.last.trim()];return parts.filter(part=>part!=='').join(' ');}",
    "wrong-padding": "interface Person{first:string;last:string;}const fullName=(person:Person):string=>[person.first,person.last].filter(Boolean).join(' ');",
    "wrong-any-field": "interface Person{first:any;last:any;}const fullName=(person:Person):string=>[person.first,person.last].filter(Boolean).join(' ');",
    "wrong-any-return": "interface Person{first:string;last:string;}const fullName=(person:Person):any=>[person.first,person.last].filter(Boolean).join(' ');",
    "wrong-mutates": "interface Person{first:string;last:string;}function fullName(person:Person):string{person.first=person.first.trim();person.last=person.last.trim();return [person.first,person.last].filter(Boolean).join(\" \");}"
  },
  "ts-optional-nickname": {
    "alternative": "type User={name:string,nickname?:string};function displayName(user:User):string{return user.nickname===undefined?user.name:user.nickname;}",
    "wrong-falsey": "interface User{name:string;nickname?:string;}const displayName=(user:User):string=>user.nickname||user.name;",
    "wrong-any-fields": "interface User{name:any;nickname?:any;}const displayName=(user:User):string=>user.nickname??user.name;",
    "wrong-any-return": "interface User{name:string;nickname?:string;}const displayName=(user:User):any=>user.nickname??user.name;",
    "wrong-mutates": "interface User{name:string;nickname?:string;}function displayName(user:User):string{const result=user.nickname??user.name;user.name=\"changed\";return result;}"
  }
}
