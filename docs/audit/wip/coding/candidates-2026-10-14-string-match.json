{
  "js-easy3-hex-colour": {
    "alternative": "function isHexColour(text){if(text.length!==7||text[0]!=='#')return false;for(let i=1;i<7;i++){const c=text[i].toLowerCase();if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))return false;}return true;}",
    "wrong-substring": "const isHexColour=text=>/#[0-9a-f]{6}/i.test(text);",
    "wrong-short": "const isHexColour=text=>/^#[0-9a-f]{3,6}$/i.test(text);",
    "wrong-multiline": "const isHexColour=text=>/^#[0-9a-f]{6}$/im.test(text);"
  },
  "js-easy3-find-hashtags": {
    "alternative": "function hashtags(text){const out=[];const allowed=c=>c>='a'&&c<='z'||c>='A'&&c<='Z'||c>='0'&&c<='9'||c==='_';for(let i=0;i<text.length;i++){if(text[i]!=='#')continue;const start=i++;while(i<text.length&&allowed(text[i]))i++;if(i>start+1)out.push(text.slice(start,i));i--;}return out;}",
    "wrong-first-only": "const hashtags=text=>{const result=text.match(/#\\w+/);return result?[result[0]]:[];};",
    "wrong-letters-only": "const hashtags=text=>text.match(/#[a-z]+/gi)??[];",
    "wrong-deduplicates": "const hashtags=text=>[...new Set(text.match(/#\\w+/g)??[])];",
    "wrong-unicode": "const hashtags=text=>text.match(/#[\\p{L}\\p{N}_]+/gu)??[];"
  },
  "js-easy3-read-query": {
    "alternative": "function parseQuery(query){const result=Object.create(null);for(const pair of query.split('&')){if(pair==='')continue;const at=pair.indexOf('=');const key=at<0?pair:pair.slice(0,at);const value=at<0?'':pair.slice(at+1);result[key]=value;}return result;}",
    "wrong-first-wins": "function parseQuery(query){const result=Object.create(null);for(const pair of query.split('&')){if(!pair)continue;const i=pair.indexOf('=');const key=i<0?pair:pair.slice(0,i);if(!(key in result))result[key]=i<0?'':pair.slice(i+1);}return result;}",
    "wrong-split-all": "const parseQuery=query=>Object.fromEntries(query.split('&').filter(Boolean).map(pair=>{const[key,value='']=pair.split('=');return[key,value];}));",
    "wrong-prototype-assignment": "function parseQuery(query){const result={};for(const pair of query.split('&')){if(!pair)continue;const i=pair.indexOf('=');result[i<0?pair:pair.slice(0,i)]=i<0?'':pair.slice(i+1);}return result;}"
  },
  "js-repeat-word": {
    "alternative": "const repeat=(word,times)=>times===0?'':(word+' ').repeat(times).slice(0,-1);",
    "wrong-no-spaces": "const repeat=(word,times)=>word.repeat(times);",
    "wrong-trims": "const repeat=(word,times)=>Array(times).fill(word).join(' ').trim();",
    "wrong-trailing-space": "const repeat=(word,times)=>(word+' ').repeat(times);"
  },
  "js-palindrome": {
    "alternative": "function isPalindrome(text){let left=0,right=text.length-1;while(left<right){if(text[left++]!==text[right--])return false;}return true;}",
    "wrong-ends-only": "const isPalindrome=text=>text.length<2||text[0]===text[text.length-1];",
    "wrong-empty": "const isPalindrome=text=>text.length>0&&text===text.split('').reverse().join('');",
    "wrong-always-true": "const isPalindrome=text=>true;"
  }
}
