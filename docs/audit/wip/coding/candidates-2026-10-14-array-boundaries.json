{
 "js-debug-average": {
  "alternative":"function average(numbers){if(!numbers.length)return 0;let total=0;for(const number of numbers)total+=number;return total/numbers.length;}",
  "wrong-sum":"const average=numbers=>numbers.reduce((a,n)=>a+n,0);",
  "wrong-online-rounding":"const average=numbers=>numbers.reduce((mean,n,i)=>mean+(n-mean)/(i+1),0);",
  "wrong-mutation":"function average(numbers){if(!numbers.length)return 0;const count=numbers.length;let total=0;while(numbers.length)total+=numbers.pop();return total/count;}"
 },
 "js-fizz-values": {
  "alternative":"function fizz(n){const out=[];let i=1;while(i<=n){out.push(i%3===0?'Fizz':i);i++;}return out;}",
  "wrong-zero-start":"const fizz=n=>Array.from({length:n},(_,i)=>i%3===0?'Fizz':i);",
  "wrong-exclusive-end":"const fizz=n=>Array.from({length:Math.max(0,n-1)},(_,i)=>(i+1)%3===0?'Fizz':i+1);",
  "wrong-case":"const fizz=n=>Array.from({length:n},(_,i)=>(i+1)%3===0?'fizz':i+1);"
 },
 "js-easy2-flatten-once": {
  "alternative":"function flattenOnce(list){const out=[];for(const item of list){if(Array.isArray(item)){for(const child of item)out.push(child);}else out.push(item);}return out;}",
  "wrong-too-deep":"const flattenOnce=list=>list.flat(Infinity);",
  "wrong-reuses-flat":"const flattenOnce=list=>list.some(Array.isArray)?list.flat():list;",
  "wrong-mutates":"const flattenOnce=list=>{const result=list.flat();list.push(99);return result;};"
 },
 "js-easy4-undo-last": {
  "alternative":"function undo(history){if(!history.length)return null;const newest=history[history.length-1];history.length=history.length-1;return newest;}",
  "wrong-peeks":"const undo=history=>history.length?history[history.length-1]:null;",
  "wrong-falsey":"const undo=history=>history.pop()||null;",
  "wrong-nullish":"const undo=history=>history.pop()??null;"
 },
 "js-easy4-split-command": {
  "alternative":"const readCommand=words=>({command:words.length?words[0]:null,args:words.slice(1)});",
  "wrong-mutates":"const readCommand=words=>({command:words.length?words.shift():null,args:words});",
  "wrong-empty-command":"const readCommand=words=>({command:words[0]||null,args:words.slice(1)});",
  "wrong-empty-reuse":"const readCommand=words=>words.length?{command:words[0],args:words.slice(1)}:{command:null,args:words};"
 }
}
