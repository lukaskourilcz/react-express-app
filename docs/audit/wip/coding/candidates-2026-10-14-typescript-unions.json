{
  "ts-padded-id": {
    "alternative": "function idText(id:string|number):string{if(typeof id==='string')return id;const value=String(id);return ('0000'+value).slice(-Math.max(4,value.length));}",
    "wrong-pads-strings": "const idText=(id:string|number):string=>String(id).padStart(4,'0');",
    "wrong-truncates": "const idText=(id:string|number):string=>typeof id==='string'?id:('0000'+String(id)).slice(-4);",
    "wrong-any-result": "const idText=(id:string|number):any=>typeof id==='number'?String(id).padStart(4,'0'):id;"
  },
  "ts-shipping-speed": {
    "alternative": "type Speed='standard'|'express'|'overnight';function shippingDays(speed:Speed,weekend:boolean):number{switch(speed){case 'standard':return 5+Number(weekend);case 'express':return 2+Number(weekend);default:return 1+Number(weekend);}}",
    "wrong-weekend": "type Speed='standard'|'express'|'overnight';const shippingDays=(speed:Speed,weekend:boolean):number=>speed==='standard'?5:speed==='express'?2:1;",
    "wrong-any-result": "type Speed='standard'|'express'|'overnight';const shippingDays=(speed:Speed,weekend:boolean):any=>(speed==='standard'?5:speed==='express'?2:1)+Number(weekend);",
    "wrong-weekend-type": "type Speed='standard'|'express'|'overnight';const shippingDays=(speed:Speed,weekend:any):number=>(speed==='standard'?5:speed==='express'?2:1)+Number(weekend);"
  },
  "ts-split-a-name": {
    "alternative": "function splitName(text:string):[string,string]{const pieces=text.split(' ');return [pieces[0],pieces.slice(1).join(' ')];}",
    "wrong-trims": "function splitName(text:string):[string,string]{const parts=text.trim().split(/\\s+/);return [parts[0],parts.slice(1).join(' ')];}",
    "wrong-second-only": "function splitName(text:string):[string,string]{const parts=text.split(' ');return [parts[0],parts[1]??''];}",
    "wrong-any-fields": "function splitName(text:string):[any,any]{const i=text.indexOf(' ');return i<0?[text,'']:[text.slice(0,i),text.slice(i+1)];}"
  },
  "ts-tally-votes": {
    "alternative": "function tally(votes:string[]):Record<string,number>{const result:Record<string,number>={};for(const vote of votes){const count=Object.prototype.hasOwnProperty.call(result,vote)?result[vote]:0;Object.defineProperty(result,vote,{value:count+1,writable:true,enumerable:true,configurable:true});}return result;}",
    "wrong-prototype-lookup": "const tally=(votes:string[]):Record<string,number>=>votes.reduce<Record<string,number>>((result,vote)=>({...result,[vote]:(result[vote]??0)+1}),{});",
    "wrong-deduplicates": "function tally(votes:string[]):Record<string,number>{return Object.fromEntries(votes.map(v=>[v,1]));}",
    "wrong-mutates": "function tally(votes:string[]):Record<string,number>{const result:Record<string,number>=Object.create(null);for(const v of votes)result[v]=(result[v]??0)+1;votes.reverse();return result;}"
  },
  "ts-rotate-a-list": {
    "alternative": "function rotate(items:readonly string[]):string[]{return Array.from({length:items.length},(_,index)=>items[(index+1)%items.length]);}",
    "wrong-reuses-tiny": "function rotate(items:readonly string[]):string[]{if(items.length<2)return items as string[];return [...items.slice(1),items[0]];}",
    "wrong-any-result": "const rotate=(items:readonly string[]):any=>items.length?[...items.slice(1),items[0]]:[];",
    "wrong-mutates": "function rotate(items:readonly string[]):string[]{const source=items as string[];const first=source.shift();if(first!==undefined)source.push(first);return source.slice();}"
  }
