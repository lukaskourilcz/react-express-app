{
  "js-easy4-allowed-file": {
    "alternative": "const isAllowed=(name,allowed)=>{const parts=name.split(\".\");return parts.length>1&&new Set(allowed).has(parts.at(-1).toLowerCase());};",
    "wrong-rejects-dot-name": "const isAllowed=(name,allowed)=>{const dot=name.lastIndexOf(\".\");return dot>0&&allowed.includes(name.slice(dot+1).toLowerCase());};",
    "wrong-trims": "const isAllowed=(name,allowed)=>{const dot=name.lastIndexOf(\".\");return dot>=0&&allowed.includes(name.slice(dot+1).toLowerCase().trim());};",
    "wrong-mutates-allowed": "const isAllowed=(name,allowed)=>{const dot=name.lastIndexOf(\".\");const out=dot>=0&&allowed.includes(name.slice(dot+1).toLowerCase());allowed.sort();return out;};"
  },
  "js-easy4-next-step": {
    "alternative": "const nextStep=(steps,current)=>{for(let i=0;i<steps.length;i++)if(steps[i]===current)return i+1<steps.length?steps[i+1]:null;return null;};",
    "wrong-last-index": "const nextStep=(steps,current)=>{const i=steps.lastIndexOf(current);return i<0?null:steps[i+1]??null;};",
    "wrong-falsy-next": "const nextStep=(steps,current)=>{const i=steps.indexOf(current);return i<0?null:steps[i+1]||null;};",
    "wrong-mutates-after": "const nextStep=(steps,current)=>{const i=steps.indexOf(current),out=i<0?null:steps[i+1]??null;steps.sort();return out;};"
  },
  "js-easy3-positions-of": {
    "alternative": "const positionsOf=(list,value)=>list.reduce((out,item,i)=>{if(item===value)out.push(i);return out;},[]);",
    "wrong-object-is": "const positionsOf=(list,value)=>list.flatMap((v,i)=>Object.is(v,value)?[i]:[]);",
    "wrong-mutates-after": "const positionsOf=(list,value)=>{const out=list.flatMap((v,i)=>v===value?[i]:[]);list.reverse();return out;};",
    "wrong-reuses-empty": "const positionsOf=(list,value)=>list.length?list.flatMap((v,i)=>v===value?[i]:[]):list;"
  },
  "js-easy4-insert-position": {
    "alternative": "const insertAt=(a,value)=>{let lo=0,hi=a.length;while(lo<hi){const mid=lo+Math.floor((hi-lo)/2);if(a[mid]<value)lo=mid+1;else hi=mid;}return lo;};",
    "wrong-rounds": "const insertAt=(a,value)=>{const i=a.findIndex(v=>Math.round(v)>=Math.round(value));return i<0?a.length:i;};",
    "wrong-mutates": "const insertAt=(a,value)=>{const i=a.findIndex(v=>v>=value),at=i<0?a.length:i;a.splice(at,0,value);return at;};",
    "wrong-upper-bound": "const insertAt=(a,value)=>{const i=a.findIndex(v=>v>value);return i<0?a.length:i;};"
  },
  "js-debug-remove-item": {
    "alternative": "const without=(items,unwanted)=>items.reduce((out,item)=>{if(item!==unwanted)out.push(item);return out;},[]);",
    "wrong-same-value-zero": "const without=(items,unwanted)=>items.filter(item=>![unwanted].includes(item));",
    "wrong-structural": "const without=(items,unwanted)=>items.filter(item=>JSON.stringify(item)!==JSON.stringify(unwanted));",
    "wrong-reuses-empty": "const without=(items,unwanted)=>items.length?items.filter(item=>item!==unwanted):items;"
  }
}
