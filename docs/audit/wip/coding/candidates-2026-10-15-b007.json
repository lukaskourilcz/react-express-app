{
  "js-easy2-all-tags": {
    "alternative": "const allTags=posts=>{const out=[];for(const post of posts)for(const tag of post.tags)out.push(tag);return out;};",
    "wrong-reuses-single": "const allTags=posts=>posts.length===1?posts[0].tags:posts.flatMap(p=>p.tags);",
    "wrong-mutates-after": "const allTags=posts=>{const out=posts.flatMap(p=>p.tags);for(const p of posts)p.tags.reverse();return out;};",
    "wrong-deduplicates": "const allTags=posts=>[...new Set(posts.flatMap(p=>p.tags))];"
  },
  "js-easy3-column-totals": {
    "alternative": "const columnTotals=g=>g.length?Array.from({length:g[0].length},(_,c)=>g.reduce((sum,row)=>sum+row[c],0)):[];",
    "wrong-reuses-single-row": "const columnTotals=g=>g.length===1?g[0]:g.length?g[0].map((_,c)=>g.reduce((s,r)=>s+r[c],0)):[];",
    "wrong-mutates-one-row": "const columnTotals=g=>{const out=g.length?g[0].map((_,c)=>g.reduce((s,r)=>s+r[c],0)):[];if(g.length===1)g[0].reverse();return out;};",
    "wrong-row-sums": "const columnTotals=g=>g.map(row=>row.reduce((s,n)=>s+n,0));"
  },
  "js-easy4-place-totals": {
    "alternative": "const placeTotals=ns=>ns.reduce((a,n,i)=>(a[i%2?\"odd\":\"even\"]+=n,a),{even:0,odd:0});",
    "wrong-mutates-after": "const placeTotals=ns=>{const out=ns.reduce((a,n,i)=>(a[i%2?\"odd\":\"even\"]+=n,a),{even:0,odd:0});ns.reverse();return out;};",
    "wrong-reuses-result": "const shared={even:0,odd:0};const placeTotals=ns=>{shared.even=0;shared.odd=0;ns.forEach((n,i)=>shared[i%2?\"odd\":\"even\"]+=n);return shared;};",
    "wrong-value-parity": "const placeTotals=ns=>ns.reduce((a,n)=>(a[n%2?\"odd\":\"even\"]+=n,a),{even:0,odd:0});"
  },
  "js-easy3-every-combination": {
    "alternative": "const combinations=(sizes,colours)=>{const out=[];let index=0;sizes.forEach(size=>colours.forEach(colour=>{out[index++]=[size,colour].join(\" \");}));return out;};",
    "wrong-deduplicates": "const combinations=(s,c)=>[...new Set(s.flatMap(x=>c.map(y=>x+\" \"+y)))];",
    "wrong-trims": "const combinations=(s,c)=>s.flatMap(x=>c.map(y=>(x+\" \"+y).trim()));",
    "wrong-mutates-after": "const combinations=(s,c)=>{const out=s.flatMap(x=>c.map(y=>x+\" \"+y));s.reverse();c.reverse();return out;};"
  },
  "js-easy3-discount-in-place": {
    "alternative": "const applyDiscount=(items,p)=>{for(const item of items)item.price=Math.round(item.price*(100-p)/100);};",
    "wrong-replaces-objects": "const applyDiscount=(items,p)=>{items.forEach((item,i)=>items[i]={...item,price:Math.round(item.price*(100-p)/100)});};",
    "wrong-floating-factor": "const applyDiscount=(items,p)=>{const f=1-p/100;items.forEach(item=>item.price=Math.round(item.price*f));};",
    "wrong-returns-array": "const applyDiscount=(items,p)=>{items.forEach(item=>item.price=Math.round(item.price*(100-p)/100));return items;};"
  }
}
