  },
  "js-remove-a-range": {
    "alternative": "function removeRange(list,start,count){const removed=list.splice(start,count);return removed;}",
    "wrong-clone": "function removeRange(list,start,count){return structuredClone(list.splice(start,count));}",
    "wrong-negative": "function removeRange(list,start,count){return list.splice(Math.max(0,start),count);}"
  },
  "js-copy-a-range": {
