{
  "js-swap-stack-top": {
    "alternative": "function swapTop(stack,item){const removed=stack.pop();stack.push(item);return removed;}",
    "wrong-clone": "function swapTop(stack,item){const top=stack.pop();stack.push(item);return structuredClone(top);}",
    "wrong-nan": "function swapTop(stack,item){const top=stack.pop();stack.push(item);return Number.isNaN(top)?null:top;}"
