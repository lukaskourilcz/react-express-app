{
 "js-binary-search":{
  "alternative":"function binarySearch(sorted,target){let from=0,to=sorted.length;while(from<to){const mid=from+Math.floor((to-from)/2),value=sorted[mid];if(value===target)return mid;if(value<target)from=mid+1;else to=mid;}return -1;}",
  "wrong-round-target":"function binarySearch(sorted,target){target=Math.round(target);let lo=0,hi=sorted.length-1;while(lo<=hi){const mid=Math.floor((lo+hi)/2);if(sorted[mid]===target)return mid;if(sorted[mid]<target)lo=mid+1;else hi=mid-1;}return -1;}",
  "wrong-extra-property":"function binarySearch(sorted,target){sorted.checked=true;let lo=0,hi=sorted.length-1;while(lo<=hi){const mid=Math.floor((lo+hi)/2);if(sorted[mid]===target)return mid;if(sorted[mid]<target)lo=mid+1;else hi=mid-1;}return -1;}",
  "wrong-linear":"function binarySearch(sorted,target){return sorted.indexOf(target);}"
 },
 "js-digit-sum":{
  "alternative":"function digitSum(n){let sum=0;do{sum+=n%10;n=Math.trunc(n/10);}while(n>0);return sum;}",
  "wrong-small-only":"function digitSum(n){n%=1000000;let total=0;while(n>0){total+=n%10;n=Math.floor(n/10);}return total;}",
  "wrong-no-floor":"function digitSum(n){let total=0;while(n>0){total+=n%10;n=n/10;}return total;}",
  "wrong-unique-digits":"function digitSum(n){let sum=0;for(const c of new Set(String(n)))sum+=Number(c);return sum;}"
 },
 "js-count-multiples":{
  "alternative":"function countMultiples(n,from,to){if(from>to)return 0;return Math.floor(to/n)-Math.ceil(from/n)+1;}",
  "wrong-nonnegative-only":"function countMultiples(n,from,to){let count=0;for(let value=from;value<=to;value++)if(value>=0&&value%n===0)count++;return count;}",
  "wrong-skip-end":"function countMultiples(n,from,to){let count=0;for(let value=from;value<to;value++)if(value%n===0)count++;return count;}",
  "wrong-zero-divisor-model":"function countMultiples(n,from,to){let count=0;for(let value=from;value<=to;value++)if(value!==0&&value%n===0)count++;return count;}"
 },
 "js-words-of-length":{
  "alternative":"function countWordsOfLength(sentence,length){if(sentence==='')return 0;return sentence.split(' ').reduce((count,word)=>count+Number(word.length===length),0);}",
  "wrong-empty-token":"function countWordsOfLength(sentence,length){return sentence.split(' ').filter(word=>word.length===length).length;}",
  "wrong-code-points":"function countWordsOfLength(sentence,length){if(sentence==='')return 0;let count=0;for(const word of sentence.split(' '))if(Array.from(word).length===length)count++;return count;}",
  "wrong-normalize":"function countWordsOfLength(sentence,length){if(sentence==='')return 0;let count=0;for(const word of sentence.split(' '))if(word.normalize('NFC').length===length)count++;return count;}"
 },
 "js-queue-with-shift":{
  "alternative":"function serveNext(queue,newcomer){return (queue.push(newcomer),queue.shift());}",
  "wrong-falsy-fallback":"function serveNext(queue,newcomer){queue.push(newcomer);return queue.shift()||newcomer;}",
  "wrong-clone-served":"function serveNext(queue,newcomer){queue.push(newcomer);const served=queue.shift();return served&&typeof served==='object'?{...served}:served;}",
  "wrong-empty-undefined":"function serveNext(queue,newcomer){if(!queue.length)return undefined;queue.push(newcomer);return queue.shift();}"
 }
}
