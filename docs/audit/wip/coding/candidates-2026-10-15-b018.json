{
  "js-easy3-parse-or-fallback": {
    "alternative": "function parseOr(text,fallback){try{return JSON.parse(text);}catch{return fallback;}}",
    "wrong-clone-fallback": "const parseOr=(text,fallback)=>{try{return JSON.parse(text);}catch{return JSON.parse(JSON.stringify(fallback));}};",
    "wrong-false": "const parseOr=(text,fallback)=>{try{const value=JSON.parse(text);return value===false?fallback:value;}catch{return fallback;}};"
  },
  "js-easy3-pretty-json": {
    "alternative": "function toFileText(value){return JSON.stringify(value,null,2)+'\\n';}",
    "wrong-ascii": "const toFileText=value=>JSON.stringify(value,null,2).replace(/[^\\x00-\\x7F]/g,'?')+'\\n';",
    "wrong-sort-keys": "const toFileText=value=>JSON.stringify(value&&typeof value==='object'&&!Array.isArray(value)?Object.fromEntries(Object.entries(value).sort(([a],[b])=>a.localeCompare(b))):value,null,2)+'\\n';"
  },
  "js-easy4-public-fields": {
    "alternative": "function toPublicJson(user){return JSON.stringify(user,['id','name','avatar']);}",
    "wrong-clone-user": "const toPublicJson=user=>JSON.stringify(JSON.parse(JSON.stringify(user)),['id','name','avatar']);",
    "wrong-short-name": "const toPublicJson=user=>JSON.stringify({...user,name:typeof user.name==='string'?user.name.slice(0,100):user.name},['id','name','avatar']);"
  },
  "js-easy3-sort-numbers": {
    "alternative": "function sortNumbers(values){return values.slice().sort((a,b)=>a-b);}",
    "wrong-zero": "const sortNumbers=a=>a.map(x=>x||0).sort((x,y)=>x-y);",
    "wrong-large": "const sortNumbers=a=>a.length>12?a.slice():a.slice().sort((x,y)=>x-y);"
  },
  "js-chunk-an-array": {
    "alternative": "function chunk(items,size){const out=[];for(let i=0;i<items.length;i+=size)out.push(items.slice(i,i+size));return out;}",
    "wrong-clone": "const chunk=(items,size)=>Array.from({length:Math.ceil(items.length/size)},(_,i)=>JSON.parse(JSON.stringify(items.slice(i*size,(i+1)*size))));",
    "wrong-splice": "const chunk=(items,size)=>{const out=[];while(items.length)out.push(items.splice(0,size));return out;};"
  }
}
