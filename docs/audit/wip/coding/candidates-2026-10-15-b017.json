"js-easy2-call-n-times":{"alternative":"function times(n,fn){const out=[];for(let i=0;i<n;i++)out.push(fn(i));return out;}","wrong-clone":"const times=(n,fn)=>Array.from({length:n},(_,i)=>{const x=fn(i);return x&&typeof x==='object'?JSON.parse(JSON.stringify(x)):x;});","wrong-extra-args":"const times=(n,fn)=>Array.from({length:n},(_,i)=>fn(i,n));"},
"js-easy2-count-where":{"alternative":"function countWhere(list,test){let n=0;for(const x of list)if(test(x))n++;return n;}","wrong-twice":"const countWhere=(list,test)=>{let n=0;for(const x of list){test(x);if(test(x))n++;}return n;};","wrong-mutate":"const countWhere=(list,test)=>{let n=0;while(list.length)if(test(list.shift()))n++;return n;};"},
"js-easy3-multiply-by":{"alternative":"function multiplyBy(factor){return function(n){return n*factor;};}","wrong-signed-zero":"const multiplyBy=factor=>n=>(n*factor)||0;","wrong-round":"const multiplyBy=factor=>n=>Math.round(n*factor*10)/10;"},
"js-easy2-negate-a-test":{"alternative":"function negate(test){return (...args)=>Boolean(!test(...args));}","wrong-twice":"const negate=test=>(...args)=>{test(...args);return !test(...args);};","wrong-clone":"const negate=test=>(...args)=>!test(...JSON.parse(JSON.stringify(args)));"},
"js-easy4-record-calls":{"alternative":"function recorded(fn,calls){return (...args)=>{const result=fn(...args);calls.push({args,result});return result;};}","wrong-clone":"const recorded=(fn,calls)=>(...args)=>{const result=fn(...args);calls.push(JSON.parse(JSON.stringify({args,result})));return result;};","wrong-before":"const recorded=(fn,calls)=>(...args)=>{const entry={args};calls.push(entry);const result=fn(...args);entry.result=result;return result;};"}
