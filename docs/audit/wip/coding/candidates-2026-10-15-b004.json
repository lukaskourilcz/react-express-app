{
  "js-easy4-header-and-footer": {
    "alternative": "const framed=(rows,header,footer)=>[header,...rows,footer];",
    "wrong-flattens-footer": "const framed=(rows,header,footer)=>[header].concat(rows,footer);",
    "wrong-clones-rows": "const framed=(rows,header,footer)=>[header,...JSON.parse(JSON.stringify(rows)),footer];",
    "wrong-reorders": "const framed=(rows,header,footer)=>[header,...[...rows].reverse(),footer];"
  },
  "js-easy3-add-to-playlist": {
    "alternative": "const addSongs=(list,songs)=>[...list,...(Array.isArray(songs)?songs:[songs])];",
    "wrong-reuses-empty": "const addSongs=(list,songs)=>Array.isArray(songs)&&!songs.length?list:list.concat(songs);",
    "wrong-mutates-songs": "const addSongs=(list,songs)=>{const out=list.concat(songs);if(Array.isArray(songs))songs.length=0;return out;};",
    "wrong-deduplicates": "const addSongs=(list,songs)=>[...new Set(list.concat(songs))];"
  },
  "js-easy4-csv-line": {
    "alternative": "const toCsvLine=values=>values.reduce((out,v,i)=>out+(i?\",\":\"\")+(v==null?\"\":String(v)),\"\");",
    "wrong-filters-empty": "const toCsvLine=values=>values.filter(v=>v!=null).join(\",\");",
    "wrong-stringifies-null": "const toCsvLine=values=>values.map(String).join(\",\");",
    "wrong-mutates": "const toCsvLine=values=>{const line=values.join(\",\");values.reverse();return line;};"
  },
  "js-easy4-last-few": {
    "alternative": "const lastFew=(items,n)=>items.slice(items.length-Math.min(n,items.length));",
    "wrong-minus-zero": "const lastFew=(items,n)=>items.slice(-n);",
    "wrong-reuses-empty": "const lastFew=(items,n)=>!items.length?items:n===0?[]:items.slice(-n);",
    "wrong-clones": "const lastFew=(items,n)=>JSON.parse(JSON.stringify(n===0?[]:items.slice(-n)));"
  },
  "js-easy2-page-of-results": {
    "alternative": "const page=(items,p,size)=>items.filter((_,i)=>i>=(p-1)*size&&i<p*size);",
    "wrong-zero-based": "const page=(items,p,size)=>items.slice(p*size,(p+1)*size);",
    "wrong-reuses-whole": "const page=(items,p,size)=>p===1&&size>=items.length?items:items.slice((p-1)*size,p*size);",
    "wrong-clones": "const page=(items,p,size)=>JSON.parse(JSON.stringify(items.slice((p-1)*size,p*size)));"
  }
}
