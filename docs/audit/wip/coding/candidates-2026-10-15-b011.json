{
  "js-easy3-hide-banned": {
    "alternative": "const hideBanned=(words,banned)=>{const blocked=new Set(banned);const out=[];for(const word of words)out.push(blocked.has(word)?\"***\":word);return out;};",
    "wrong-reuses-empty-bans": "const hideBanned=(w,b)=>b.length?w.map(x=>b.includes(x)?\"***\":x):w;",
    "wrong-mutates-banned": "const hideBanned=(w,b)=>{const out=w.map(x=>b.includes(x)?\"***\":x);b.sort();return out;};",
    "wrong-regex": "const hideBanned=(w,b)=>w.map(x=>b.some(pattern=>new RegExp(\"^\"+pattern+\"$\").test(x))?\"***\":x);"
  },
  "js-easy4-any-overdue": {
    "alternative": "const hasOverdue=(tasks,today)=>{for(const t of tasks)if(t.done===false&&t.due<today)return true;return false;};",
    "wrong-mutates-after": "const hasOverdue=(tasks,today)=>{const out=tasks.some(t=>!t.done&&t.due<today);tasks.reverse();return out;};",
    "wrong-due-today": "const hasOverdue=(tasks,today)=>tasks.some(t=>!t.done&&t.due<=today);",
    "wrong-first-only": "const hasOverdue=(tasks,today)=>!!tasks.length&&!tasks[0].done&&tasks[0].due<today;"
  },
  "js-easy3-first-over-limit": {
    "alternative": "const firstOverLimit=(a,limit)=>{let out=-1;a.forEach((v,i)=>{if(out<0&&v>limit)out=i;});return out;};",
    "wrong-mutates-after": "const firstOverLimit=(a,limit)=>{const out=a.findIndex(v=>v>limit);a.reverse();return out;};",
    "wrong-rounds": "const firstOverLimit=(a,limit)=>a.findIndex(v=>Math.round(v)>Math.round(limit));",
    "wrong-last": "const firstOverLimit=(a,limit)=>a.findLastIndex(v=>v>limit);"
  },
  "js-easy4-first-free-slot": {
    "alternative": "const firstFree=slots=>{for(const slot of slots)if(slot.booked===false)return slot.time;return null;};",
    "wrong-zero-hour": "const firstFree=slots=>{const s=slots.find(s=>!s.booked);return s&&parseInt(s.time)?s.time:null;};",
    "wrong-first-three": "const firstFree=slots=>slots.slice(0,3).find(s=>!s.booked)?.time??null;",
    "wrong-books-slot": "const firstFree=slots=>{const s=slots.find(s=>!s.booked);if(!s)return null;s.booked=true;return s.time;};"
  },
  "js-easy3-form-complete": {
    "alternative": "const isComplete=form=>Object.entries(form).reduce((out,[,value])=>out&&value.trim().length>0,true);",
    "wrong-inherited": "const isComplete=form=>{for(const key in form)if(!form[key].trim())return false;return true;};",
    "wrong-trims-input": "const isComplete=form=>{for(const key of Object.keys(form))form[key]=form[key].trim();return Object.values(form).every(Boolean);};",
    "wrong-spaces-only": "const isComplete=form=>Object.values(form).every(value=>value.replace(/ /g,\"\").length>0);"
  }
}
