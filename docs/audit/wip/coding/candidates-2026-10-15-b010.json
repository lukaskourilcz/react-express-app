{
  "js-easy4-expand-ranges": {
    "alternative": "const expand=ranges=>{const out=[];for(const [from,to] of ranges)for(let n=from;n<=to;n++)out.push(n);return out;};",
    "wrong-deduplicates": "const expand=ranges=>[...new Set(ranges.flatMap(([a,b])=>Array.from({length:b-a+1},(_,i)=>a+i)))];",
    "wrong-sorts": "const expand=ranges=>ranges.flatMap(([a,b])=>Array.from({length:b-a+1},(_,i)=>a+i)).sort((a,b)=>a-b);",
    "wrong-mutates": "const expand=ranges=>{const out=ranges.flatMap(([a,b])=>Array.from({length:b-a+1},(_,i)=>a+i));ranges.reverse();return out;};"
  },
  "js-easy2-every-pair": {
    "alternative": "const allPairs=list=>{const out=[];list.forEach((a,i)=>list.forEach((b,j)=>{if(j>i)out.push([a,b]);}));return out;};",
    "wrong-clones": "const allPairs=list=>{const a=JSON.parse(JSON.stringify(list));return a.flatMap((v,i)=>a.slice(i+1).map(w=>[v,w]));};",
    "wrong-mutates-after": "const allPairs=list=>{const out=list.flatMap((v,i)=>list.slice(i+1).map(w=>[v,w]));list.reverse();return out;};",
    "wrong-skips-equal": "const allPairs=list=>list.flatMap((v,i)=>list.slice(i+1).filter(w=>w!==v).map(w=>[v,w]));"
  },
  "js-easy2-sorted-squares": {
    "alternative": "const sortedSquares=a=>{let split=a.findIndex(n=>n>=0);if(split<0)split=a.length;let left=split-1,right=split;const out=[];while(left>=0||right<a.length){if(right>=a.length||(left>=0&&a[left]*a[left]<=a[right]*a[right]))out.push(a[left]*a[left--]);else out.push(a[right]*a[right++]);}return out;};",
    "wrong-deduplicates": "const sortedSquares=a=>[...new Set(a.map(n=>n*n))].sort((a,b)=>a-b);",
    "wrong-mutates-input": "const sortedSquares=a=>{const out=a.map(n=>n*n).sort((a,b)=>a-b);if(a.length>2)a.reverse();return out;};",
    "wrong-reuses-empty": "const sortedSquares=a=>a.length?a.map(n=>n*n).sort((a,b)=>a-b):a;"
  },
  "js-easy2-reverse-vowels": {
    "alternative": "const reverseVowels=text=>{const vowels=[...text].filter(c=>\"aeiouAEIOU\".includes(c));return text.replace(/[aeiouAEIOU]/g,()=>vowels.pop());};",
    "wrong-normalizes": "const reverseVowels=text=>{text=text.normalize(\"NFD\");const v=[...text].filter(c=>\"aeiouAEIOU\".includes(c));return text.replace(/[aeiouAEIOU]/g,()=>v.pop());};",
    "wrong-lowercase": "const reverseVowels=text=>{const a=[...text.toLowerCase()],v=a.filter(c=>\"aeiou\".includes(c));return a.map(c=>\"aeiou\".includes(c)?v.pop():c).join(\"\");};",
    "wrong-all-text": "const reverseVowels=text=>[...text].reverse().join(\"\");"
  },
  "js-easy2-outside-in": {
    "alternative": "const outsideIn=list=>Array.from({length:list.length},(_,i)=>list[i%2?list.length-1-Math.floor(i/2):i/2]);",
    "wrong-clones": "const outsideIn=list=>{const a=JSON.parse(JSON.stringify(list));return Array.from({length:a.length},(_,i)=>a[i%2?a.length-1-Math.floor(i/2):i/2]);};",
    "wrong-reuses-empty": "const outsideIn=list=>list.length?Array.from({length:list.length},(_,i)=>list[i%2?list.length-1-Math.floor(i/2):i/2]):list;",
    "wrong-mutates-long": "const outsideIn=list=>{const out=Array.from({length:list.length},(_,i)=>list[i%2?list.length-1-Math.floor(i/2):i/2]);if(list.length>3)list.reverse();return out;};"
  }
}
