# Copy to mobile/.env and fill in. EXPO_PUBLIC_* vars are inlined into the app
# bundle at build time (so use only the PUBLIC/anon values — never secrets).

# Where the Vercel API lives. Use your deployed domain, or your machine's LAN IP
# while developing (a phone can't reach "localhost").
#   prod:  https://your-app.vercel.app
#   dev :  http://192.168.1.50:3000
EXPO_PUBLIC_API_BASE_URL=https://your-app.vercel.app

# Same Supabase project the web app uses (anon key is safe to ship).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
