meta {
  name: Admin Reports no-auth
  type: http
  seq: 5
}

# api/admin/[op].ts calls requireAdmin (lib/admin-auth.ts): with no Supabase
# session, and the legacy dev password not enabled, it answers 403 'forbidden'.
get {
  url: {{baseUrl}}/api/admin/reports
  body: none
  auth: none
}

assert {
  res.status: eq 403
}
