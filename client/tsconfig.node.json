{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc-node",
    "rootDir": "..",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx"
  },
  "include": [
    "vite.config.ts",
    "vite.sandbox.config.ts",
    "product-catalog.ts",
    "src/lib/topicCatalog.ts",
    "src/components/topics/TopicArticle.tsx",
    "src/lib/publicMetadata.ts",
    "src/components/PremiumFacts.tsx",
    "src/i18n/translations.ts",
    "../shared/**/*.ts"
  ]
}
