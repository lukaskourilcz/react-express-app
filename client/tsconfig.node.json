{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc-node",
    "rootDir": "..",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "vite.config.ts",
    "vite.sandbox.config.ts",
    "product-catalog.ts",
    "src/lib/topicCatalog.ts",
    "src/lib/publicGuideHandoff.ts",
    "src/components/topics/TopicArticle.tsx",
    "src/lib/publicMetadata.ts",
    "src/components/PremiumFacts.tsx",
    "src/components/BrandCase.tsx",
    "src/components/ChangelogArticle.tsx",
    "src/components/DailyStaticArticle.tsx",
    "src/lib/changelog.ts",
    "src/og/ogImages.ts",
    "src/i18n/translations.ts",
    "../shared/**/*.ts",
    "src/components/learn/SectionPreviewStatic.tsx",
    "src/i18n/translations.learn.ts",
    "../lib/learning-paths/content/fde.ts",
    "../lib/learning-paths/content/fde/**/*.ts",
    "../lib/learning-paths/types.ts",
    "../lib/learn-lessons/types.ts",
    "../lib/coding/types.ts"
  ]
}
