# Auth0 Configuration
# Create an Auth0 Single Page Application at https://auth0.com
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
# Optional once you create an Auth0 API; enables server-side JWT verification.
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Supabase Configuration
# Create a Supabase project at https://supabase.com
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (set in Vercel project env, NOT in the client)
# Required in production. Falls back to a dev-only secret locally.
SESSION_SECRET=replace-with-a-32-byte-random-string
