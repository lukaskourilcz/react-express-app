# Supabase Configuration
# Create a Supabase project at https://supabase.com (Project Settings -> API).
# Auth is handled by Supabase Auth (Google OAuth) - enable the Google provider
# in Authentication -> Providers and add your redirect URL.
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Product identity. StudyShark is the umbrella for general subjects; devShark
# is a separate web-development deployment. Repeat PRODUCT_* server-side so
# API scope cannot drift from the built client.
VITE_PRODUCT=studyshark
# VITE_LOCK_SUBJECT=webdev
# PRODUCT_ID=studyshark
# PRODUCT_SUBJECT=webdev

# Server-only (set in Vercel project env, NOT in the client)
# Required in production. Falls back to a dev-only secret locally.
SESSION_SECRET=replace-with-a-32-byte-random-string

# Server-only service-role key (Project Settings -> API -> service_role).
# Lets the API bypass RLS for user-scoped reads/writes after it verifies the
# caller's token. NEVER expose this in the client / commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Identity-based /dev access. A verified user also qualifies when their
# app_metadata role is "admin". Legacy password access is off in production
# unless ALLOW_LEGACY_DEV_PASSWORD is deliberately enabled.
ADMIN_EMAILS=owner@example.com
# ALLOW_LEGACY_DEV_PASSWORD=false
# DEV_PASSWORD=local-development-only

# Standalone single-subject mode (OPTIONAL).
# StudyShark is the full multi-subject site. To run one subject as its OWN
# standalone site (e.g. devShark), deploy this same repo as a SECOND Vercel
# project and set VITE_LOCK_SUBJECT to that subject's id. The app then boots
# locked to it: no subject picker, no switcher, no /subjects route, and the
# wordmark becomes that subject's standalone brand (devShark, geoShark, …).
# Valid ids: webdev | geography | math | history | chess | biology | poker.
# Leave BOTH vars unset on the umbrella StudyShark deploy.
# VITE_LOCK_SUBJECT=webdev
# URL of the umbrella StudyShark site. When set (typically only on a locked
# deploy) the Profile shows a "Explore the other Shark platforms" link to it.
# VITE_SIBLING_URL=https://studyshark.vercel.app

# Canonical sibling URLs. Keep unreleased products empty; the footer will show
# "coming soon" without creating a dead link.
VITE_STUDYSHARK_URL=https://studyshark.example
VITE_DEVSHARK_URL=https://devshark.example
# VITE_GEOSHARK_URL=
# VITE_MATHSHARK_URL=
# VITE_HISTORYSHARK_URL=
# VITE_BIOSHARK_URL=
# VITE_CHESSSHARK_URL=
# VITE_POKERSHARK_URL=

# Support remains completely optional and disabled by default. Amounts are
# integer cents and are disclosed publicly on the Support page.
SUPPORT_ENABLED=false
SUPPORT_MONTHLY_TARGET_CENTS=0
SUPPORT_MONTHLY_COST_CENTS=0
SUPPORT_MONTHLY_RECEIVED_CENTS=0
SUPPORT_CARRY_CENTS=0
# SUPPORT_PROVIDER_NAME=Ko-fi
# SUPPORT_PROVIDER_URL=https://ko-fi.com/your-page

# Optional post-answer AI explanations. The key and model are server-only;
# when any gate is absent the feature is omitted from the UI.
AI_EXPLANATIONS_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Recommended distributed rate limiting in production. Local development has
# a bounded in-memory fallback.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# PostHog product analytics + session replay (OPTIONAL).
# Analytics is a no-op unless this key is set, so local/preview builds pay
# nothing. Use PostHog EU Cloud (https://eu.posthog.com) for GDPR - the project
# API key is under Project Settings -> Project API Key ("phc_...").
# Requests are reverse-proxied through the same-origin /ingest path (see the
# rewrites in vercel.json), so no third-party host is added to the CSP and
# ad-blockers don't drop events. Enable Session Replay in the PostHog project UI.
VITE_PUBLIC_POSTHOG_KEY=phc_xxx
# Optional: override the ingestion path. Defaults to the /ingest reverse proxy;
# only change this if you are NOT using the Vercel rewrites.
# VITE_PUBLIC_POSTHOG_HOST=/ingest

# Optional client error monitoring; omit to disable.
# VITE_SENTRY_DSN=
